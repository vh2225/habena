{
  "name": "habena-web",
  "version": "0.5.0",
  "license": "MIT",
  "description": "Habena local web dashboard (localhost:7700) — companion to the habena MCP safety proxy",
  "author": "Vinh Hoang",
  "homepage": "https://github.com/vh2225/habena#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vh2225/habena.git",
